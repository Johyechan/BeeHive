  m_TableData:
  - m_Id: 23901465837568000
    m_Localized: "\uC2B9\uB9AC \uC870\uAC74"
    m_Metadata:
      m_Items: []
  - m_Id: 23901985910292480
    m_Localized: "\uC0C1\uB300\uC758 \uCCB4\uB825\uC744 0\uC73C\uB85C \uB9CC\uB4E4\uBA74
      \uC2B9\uB9AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23902546864898048
    m_Localized: "\uD134"
    m_Metadata:
      m_Items: []
  - m_Id: 23903102853447680
    m_Localized: "\uD300 \uBCC0\uACBD"
    m_Metadata:
      m_Items: []
  - m_Id: 23903297582399488
    m_Localized: "\uD300 \uCC28\uB840\uAC00 \uBCC0\uACBD\uB418\uB294 \uAC83\uC744
      \uBA85\uC2DC\uD558\uB294 \uD134\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23904639164088320
    m_Localized: "\uD134 \uC885\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 23908419586752512
    m_Localized: "- \uB9E4 \uD134 \uAE08\uAD34 2\uAC1C\uB97C \uD68D\uB4DD\uD569\uB2C8\uB2E4.
      \n\n- \uC608\uC678\uB85C \uBE14\uB8E8 \uD300\uC740 \uCCAB \uBC88\uC9F8 \uD134\uC5D0
      \uAE08\uAD34 3\uAC1C \uD68D\uB4DD\uD569\uB2C8\uB2E4. \n\n- \uC0DD\uC0B0\uC790\uAC00
      \uAE08\uD654\uB97C \uC0DD\uC0B0\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23909811244236800
    m_Localized: "- \uB4DC\uB85C\uC6B0\uAC00 \uAC00\uB2A5\uD55C \uD134\uC785\uB2C8\uB2E4.\n\n-
      \uB4DC\uB85C\uC6B0\uB294 \uD55C \uD134\uC5D0 \uD55C \uBC88\uB9CC \uAC00\uB2A5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23910492587950080
    m_Localized: "- \uAE30\uBB3C \uC0DD\uC131, \uC774\uB3D9, \uACF5\uACA9 \uAC00\uB2A5\uD569\uB2C8\uB2E4.
      \n\n- \uD55C \uD134\uC5D0 \uAE30\uBB3C \uC0DD\uC131\uC740 \uD55C \uBC88\uB9CC
      \uAC00\uB2A5\uD569\uB2C8\uB2E4. \n\n- \uD55C \uD134\uC5D0 \uAC01 \uD0C0\uC785\uC758
      \uAE30\uBB3C \uB9C8\uB2E4 \uD558\uB098\uB9CC \uC774\uB3D9 \uBC0F \uACF5\uACA9
      \uAC00\uB2A5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23910913914175488
    m_Localized: "- \uD604\uC7AC \uCC28\uB840\uC778 \uD300\uC758 \uCC28\uB840\uAC00
      \uC885\uB8CC\uB418\uACE0 \uD300 \uBCC0\uACBD\uC73C\uB85C \uC774\uB3D9\uD558\uB294
      \uD134\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23918661267619840
    m_Localized: "\uCE74\uB4DC"
    m_Metadata:
      m_Items: []
  - m_Id: 23924910520532992
    m_Localized: "\uAC00\uBB44 \uCE74\uB4DC"
    m_Metadata:
      m_Items: []
  - m_Id: 23924748133859328
    m_Localized: "\uD48D\uB144 \uCE74\uB4DC"
    m_Metadata:
      m_Items: []
  - m_Id: 23924688109174784
    m_Localized: "\uC131\uBCBD \uAC15\uD654 \uCE74\uB4DC"
    m_Metadata:
      m_Items: []
  - m_Id: 23925103685009408
    m_Localized: "\uD654\uB825 \uCE74\uB4DC"
    m_Metadata:
      m_Items: []
  - m_Id: 23925236568948736
    m_Localized: "\uB3C4\uB85C \uBCC0\uD615 \uCE74\uB4DC"
    m_Metadata:
      m_Items: []
  - m_Id: 23926802965331968
    m_Localized: "- \uB300\uD3EC\uAC00 \uC6D0\uAC70\uB9AC \uACF5\uACA9\uC744 \uD558\uAC70\uB098
      \uC0C1\uB300 \uB300\uD3EC\uC758 \uACF5\uACA9\uC744 \uBC29\uC5B4\uD560 \uC218
      \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23929431380459520
    m_Localized: "- \uAE08\uAD34 4\uAC1C\uB97C \uD68D\uB4DD\uD569\uB2C8\uB2E4.\n 
      (\"\uAC00\uBB44\"\uC758 \uD6A8\uACFC\uC640 \uC0C1\uAD00 \uC5C6\uC774 \uD68D\uB4DD)"
    m_Metadata:
      m_Items: []
  - m_Id: 23929881576079360
    m_Localized: "- \uC0C1\uB300\uB294 \uB2E4\uC74C \uD134\uC5D0 \uC0DD\uC0B0\uC790\uC758
      \uC0DD\uC0B0\uC744 \uC5BB\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\n  (\uC131\uC774
      \uC0DD\uC131\uD558\uB294 \uAE08\uAD34 2\uAC1C\uB294 \uC601\uD5A5\uC744 \uBC1B\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 23930527863799808
    m_Localized: "- \uC790\uC2E0\uC758 \uB3C4\uB85C\uC640 \uC5F0\uACB0\uB41C \uC0C1\uB300\uC758
      \uB3C4\uB85C\uB97C 1\uAC1C \uC120\uD0DD\uD574 \uBCC0\uACBD\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23930835000098816
    m_Localized: "- \uC790\uC2E0\uC758 \uC131\uBCBD\uC744 \uAC15\uD654\uD574 \uC131\uC758
      \uCCB4\uB825\uC774 1\uB9CC\uD07C \uC62C\uB77C\uAC11\uB2C8\uB2E4.\n  (\uC0AC\uC6A9
      \uC2DC \uC601\uAD6C \uC0AD\uC81C)"
    m_Metadata:
      m_Items: []
  - m_Id: 23934289735057408
    m_Localized: "\uAE30\uBB3C"
    m_Metadata:
      m_Items: []
  - m_Id: 23935375761997824
    m_Localized: "- \uB9E4 \uC0DD\uC0B0 \uD134\uB9C8\uB2E4 \uD604\uC7AC \uC704\uCE58\uC5D0
      \uB530\uB77C \uB2E4\uB978 \uAC1C\uC218\uC758 \uAE08\uD654\uB97C \uC0DD\uC131\uD569\uB2C8\uB2E4.\n\r\n-
      \uC131\uACFC \uC5F0\uACB0\uB41C \uB3C4\uB85C\uC640 \uC5F0\uACB0\uB418\uC5B4
      \uC788\uC9C0 \uC54A\uB2E4\uBA74 \uC0DD\uC0B0 \uBD88\uAC00\uD569\uB2C8\uB2E4.\n\r\n-
      \uACF5\uACA9 \uBD88\uAC00 \uAE30\uBB3C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23935994723827712
    m_Localized: "- \uC774\uB3D9 \uB610\uB294 \uBC30\uCE58 \uC704\uCE58 \uC8FC\uC704\uC758
      \uC0C1\uB300\uD300 \uB3C4\uB85C\uB97C \uC790\uC2E0\uC758 \uB3C4\uB85C\uB85C
      \uBCC0\uACBD\uD569\uB2C8\uB2E4.\r\n\n- \uC0DD\uC0B0\uC790\uC640 \uBCF4\uBCD1
      \uACF5\uACA9 \uAC00\uB2A5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23936568668192768
    m_Localized: "- \uD654\uB825 \uCE74\uB4DC\uB97C \uC0AC\uC6A9\uD558\uC5EC \uC6D0\uAC70\uB9AC
      \uACF5\uACA9\uC774 \uAC00\uB2A5\uD569\uB2C8\uB2E4.\r\n\n- \uC0DD\uC0B0\uC790\uC640
      \uBCF4\uBCD1 \uACF5\uACA9 \uAC00\uB2A5\uD569\uB2C8\uB2E4.\r\n\n- \uB300\uD3EC\uB294
      \uD654\uB825\uC744 \uC0AC\uC6A9\uD55C \uC6D0\uAC70\uB9AC \uACF5\uACA9\uC73C\uB85C\uB9CC
      \uACF5\uACA9 \uAC00\uB2A5\uD569\uB2C8\uB2E4.\r\n\n- \uC6D0\uAC70\uB9AC \uACF5\uACA9\uC73C\uB85C
      \uC131 \uACF5\uACA9 \uAC00\uB2A5\uD569\uB2C8\uB2E4.\n\n- \uD654\uB825\uC744
      \uC0AC\uC6A9\uD574\uC11C \uC0C1\uB300 \uB300\uD3EC\uC758 \uC6D0\uAC70\uB9AC
      \uACF5\uACA9\uC744 \uBC29\uC5B4\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23938738515869696
    m_Localized: "- \uAE30\uBB3C\uB4E4\uC758 \uC774\uB3D9\uC744 \uB3D5\uB294 \uAE30\uBB3C\uC785\uB2C8\uB2E4.\n\n-
      \uC131\uACFC \uC5F0\uACB0\uC774 \uB418\uC5B4 \uC788\uC5B4\uC57C \uC0AC\uC6A9
      \uAC00\uB2A5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
