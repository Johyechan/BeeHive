  m_TableData:
  - m_Id: 2524761374326784
    m_Localized: "\uAC8C\uC784 \uAD6C\uC131\r\n\uACF5\uD1B5 : \uAC8C\uC784\uD310
      1\uAC1C, \uC804\uB7B5 \uCE74\uB4DC 30\uC7A5, \uAE08\uAD34 40\uAC1C, \uAE08\uD654
      8\uAC1C\r\n\uAC01 \uD50C\uB808\uC774\uC5B4(2\uBA85) : \uC131 1\uAC1C, \uC0DD\uC0B0\uC790
      2\uAC1C, \uBCF4\uBCD1 3\uAC1C, \uB300\uD3EC 2\uAC1C, \uB3C4\uB85C 72\uAC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 2525352641167360
    m_Localized: "\uAE30\uBCF8 \uC124\uC815 (2\uC778\uC6A9 \uC804\uB7B5 \uAC8C\uC784)\r\n\uC774
      \uAC8C\uC784\uC740 \uAE30\uBB3C\uC744 \uBCF4\uB0B4 \uC0C1\uB300 \uC131\uC744
      \uD568\uB77D\uD558\uB294 \uAC8C\uC784\uC774\uB2E4. \uC131\uC758 \uCCB4\uB825\uC740
      \uAC01\uAC01 5\uC774\uACE0, \uAE30\uBB3C(\uBCF4\uBCD1\uC774\uB098 \uC804\uCC28)\uC744
      \uBCF4\uB0B4 \uC0C1\uB300 \uC131\uC758 \uCCB4\uB825\uC744 0\uC73C\uB85C \uB9CC\uB4E4\uBA74
      \uC2B9\uB9AC\uD55C\uB2E4. \r\n\uC131\uC740 \uAC01\uAC01 \uD574\uB2F9 \uC0C9\uC758
      \uD0C0\uC77C \uC704\uC5D0 \uC62C\uB9AC\uACE0, \uC804\uB7B5 \uCE74\uB4DC\uB294
      \uB4B7\uC7A5\uC73C\uB85C \uC798 \uC11E\uC5B4\uC11C \uC313\uC544\uB193\uACE0
      \uAC8C\uC784\uC744 \uC2DC\uC791\uD55C\uB2E4. \uB3C4\uB85C\uB294 \uB298 \uC721\uAC01\uD615
      \uD0C0\uC77C\uC758 \uD55C \uBCC0\uC5D0 \uBC30\uCE58\uD558\uACE0, \uC0DD\uC0B0\uC790,
      \uBCF4\uBCD1, \uB300\uD3EC\uB294 \uBB34\uC870\uAC74 \uC721\uAC01\uD615 \uD0C0\uC77C\uC758
      \uAF2D\uC9D3\uC810\uC5D0 \uBC30\uCE58\uD574\uC57C \uD55C\uB2E4.\r\n\uB9E4 \uD134\uB9C8\uB2E4
      \uD50C\uB808\uC774\uD558\uB294 \uC21C\uC11C\uB294 \uB2E4\uC74C\uACFC \uAC19\uB2E4.\r\n\uC0DD\uC0B0
      \uD134  >>  \uB4DC\uB85C\uC6B0 \uD134  >>  \uBA54\uC778 \uD134  >>  \uC0C1\uB300\uC758
      \uCC28\uB840\r\n(\uC804\uB7B5 \uCE74\uB4DC\uB97C \uC4F0\uB294 \uD589\uC704\uB294
      \uC790\uC2E0\uC758 \uCC28\uB840\uC5D0 \uD134\uACFC \uC0C1\uAD00\uC5C6\uC774
      \uC5B8\uC81C\uB4E0 \uD560 \uC218 \uC788\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 2525795303817216
    m_Localized: "\uC0DD\uC0B0 \uD134\r\n\uC0DD\uC0B0 \uD134\uC740 \uC0DD\uC0B0\uC790\uC640
      \uC131\uC73C\uB85C\uBD80\uD130 \uAE08\uAD34\uC640 \uAE08\uD654\uB97C \uC5BB\uB294
      \uD134\uC774\uB2E4. \uAE30\uBCF8\uC801\uC73C\uB85C \uC131\uC740 \uAE08\uAD34
      2\uAC1C\uB97C \uC81C\uACF5\uD558\uACE0, \uC0DD\uC0B0\uC790\uB294 \uC811\uD558\uACE0
      \uC788\uB294 \uD0C0\uC77C\uC758 \uC885\uB958\uC5D0 \uB530\uB77C \uAE08\uD654\uB97C
      \uC81C\uACF5\uD55C\uB2E4. \uAE08\uD654 5\uAC1C\uAC00 \uBAA8\uC774\uBA74 \uAE08\uAD34
      1\uAC1C\uAC00 \uB41C\uB2E4. (\uAE08\uD654 5\uAC1C = \uAE08\uAD34 1\uAC1C)\r\n\r\n\uC0DD\uC0B0\uC790\uB294
      \uC790\uC2E0\uC774 \uC704\uCE58\uD55C \uACF3\uC5D0\uC11C \uC811\uD558\uB294
      \uD0C0\uC77C \uC911 \uAC00\uC7A5 \uB9CE\uC774 \uC0DD\uC0B0 \uAC00\uB2A5\uD55C
      \uD0C0\uC77C\uC758 \uAE08\uD654 \uC0DD\uC0B0\uCE58\uB9CC\uD07C \uAE08\uD654\uB97C
      \uD68D\uB4DD\uD558\uB294\uB370 \uAC01 \uD0C0\uC77C\uC758 \uC0DD\uC0B0\uCE58\uB294
      \uB2E4\uC74C\uACFC \uAC19\uB2E4.\r\n\uD0C0\uC77C \uC0C9\uC5D0 \uB530\uB77C
      \uC0DD\uC0B0\uC790\uAC00 \uAE08\uD654\uB97C \uBC84\uB294 \uC591\uC774 \uC815\uD574\uC838
      \uC788\uB2E4.(\uD0C0\uC77C \uC0C9\uC774 \uC9C4\uD574\uC9C8 \uC218 \uB85D \uB354
      \uB9CE\uC774 \uBC88\uB2E4)\r\n\uB2E4\uB9CC \uC0DD\uC0B0\uC790\uAC00 \uC0DD\uC0B0\uC744
      \uD558\uC9C0 \uBABB\uD558\uB294 \uACBD\uC6B0\uB3C4 \uC788\uB2E4. \uC0C1\uB300\uAC00
      \u2018\uAC00\uBB44\u2019 \uCE74\uB4DC\uB97C \uC0AC\uC6A9\uD588\uC744 \uACBD\uC6B0\uC640
      \uC790\uC2E0\uC758 \uC0DD\uC0B0\uC790\uAC00 \uC131\uC9C0\uC640 \uB3C4\uB85C\uB85C
      \uC5F0\uACB0\uB418\uC9C0 \uC54A\uC740 \uACBD\uC6B0\uC5D0\uB294 \uAE08\uD654
      \uC0DD\uC0B0\uC744 \uD560 \uC218 \uC5C6\uB2E4.\r\n\r\n\uC0DD\uC0B0 \uD134\uC5D0
      \uC131\uC774 \uC81C\uACF5\uD558\uB294 \uAE08\uAD34 2\uAC1C\uB294 \uBB34\uC870\uAC74
      \uBC1B\uC544\uC57C \uD558\uACE0, \uC131\uC758 \uC0DD\uC0B0\uC740 \u2018\uAC00\uBB44\u2019\uC758
      \uC601\uD5A5\uC744 \uBC1B\uC9C0 \uC54A\uB294\uB2E4. \uB2E4\uB9CC \uAC01 \uD50C\uB808\uC774\uC5B4\uB294
      \uAE08\uAD34\uB97C 20\uAC1C \uC774\uC0C1 \uAC00\uC9C8 \uC218 \uC5C6\uAE30 \uB54C\uBB38\uC5D0
      \uAE08\uAD34 20\uAC1C\uB97C \uCD08\uACFC\uD558\uB294 \uACBD\uC6B0\uC5D0\uB294
      \uC0DD\uC0B0 \uD134\uC5D0 \uAE08\uAD34\uB97C \uB354 \uC5BB\uC744 \uC218 \uC5C6\uB2E4.
      \uCD94\uAC00\uC801\uC73C\uB85C \uD6C4\uBC1C \uC8FC\uC790\uC758 \uBD88\uB9AC\uD568\uC744
      \uC0C1\uC1C4\uD558\uAE30 \uC704\uD574\uC11C \uD6C4\uBC1C \uC8FC\uC790\uC758
      \uCCAB \uC0DD\uC0B0 \uD134\uB9CC \uC131\uC73C\uB85C\uBD80\uD130 \uAE08\uAD34
      3\uAC1C\uB97C \uC5BB\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2527252967063552
    m_Localized: "\uB4DC\uB85C\uC6B0 \uD134\r\n\uB4DC\uB85C\uC6B0 \uD134\uC740 \uC804\uB7B5
      \uCE74\uB4DC\uB97C \uAD6C\uB9E4\uD558\uB294 \uD134\uC774\uB2E4. \uCE74\uB4DC\uB97C
      \uBF51\uB294 \uBE44\uC6A9\uC740 \uAE08\uAD34 2\uAC1C\uC774\uBA70 \uAC01 \uD50C\uB808\uC774\uC5B4\uB294
      \uC804\uB7B5 \uCE74\uB4DC\uB97C \uCD5C\uB300 5\uC7A5\uAE4C\uC9C0 \uBCF4\uC720\uD560
      \uC218 \uC788\uB2E4. \uB9E4 \uD134\uB9C8\uB2E4 \uAE30\uC220\uCE74\uB4DC\uB294
      1\uC7A5\uB9CC \uAD6C\uB9E4\uD560 \uC218 \uC788\uACE0, \uBF51\uC740 \uCE74\uB4DC\uB294
      \uC0C1\uB300\uAC00 \uBCFC \uC218 \uC788\uB294 \uACF3\uC5D0 \uB4B7\uBA74\uC73C\uB85C
      \uBCF4\uAD00\uD55C\uB2E4.\r\n\uD654\uB825\uC744 \uC81C\uC678\uD55C \uAC19\uC740
      \uC774\uB984\uC758 \uC804\uB7B5 \uCE74\uB4DC\uB294 \uC790\uC2E0\uC758 \uCC28\uB840\uC5D0
      \uD558\uB098\uB9CC \uC0AC\uC6A9 \uAC00\uB2A5\uD558\uACE0, \uC0AC\uC6A9\uD55C
      \uCE74\uB4DC\uB294 \uC55E\uBA74\uC73C\uB85C \uBC18\uB0A9\uD55C\uB2E4. (\uB2E8,
      \uC131\uBCBD \uAC15\uD654\uC758 \uACBD\uC6B0\uC5D0\uB294 \uD50C\uB808\uC774\uC5D0\uC11C
      \uB2E8 1\uBC88\uB9CC \uC4F8 \uC218 \uC788\uB294 \uCE74\uB4DC\uC774\uAE30 \uB54C\uBB38\uC5D0
      \uC0AC\uC6A9 \uC2DC \uC644\uC804\uD788 \uAC8C\uC784\uC5D0\uC11C \uC81C\uC678\uC2DC\uD0A8\uB2E4)\r\n\uB354
      \uBF51\uC744 \uC804\uB7B5 \uCE74\uB4DC\uAC00 \uC5C6\uB294 \uACBD\uC6B0, \uC55E\uBA74\uC73C\uB85C
      \uBC18\uB0A9\uB41C \uCE74\uB4DC\uB97C \uB2E4\uC2DC \uC11E\uC5B4\uC11C \uB4B7\uBA74\uC73C\uB85C
      \uC313\uC544\uB193\uACE0 \uBF51\uB294\uB2E4.\r\n\uC804\uB7B5 \uCE74\uB4DC\uB294
      30\uC7A5\uC73C\uB85C \uAD6C\uC131\uB418\uC5B4 \uC788\uB294\uB370, \uCD1D 5\uAC00\uC9C0
      \uC885\uB958\uC758 \uCE74\uB4DC\uAC00 \uC788\uB2E4.\r\n1. \uC131\uBCBD \uAC15\uD654
      [1\uC7A5]\r\n\uC790\uC2E0\uC758 \uC131\uBCBD\uC744 \uAC15\uD654\uD574 \uC131\uC758
      \uCCB4\uB825\uC774 1\uB9CC\uD07C \uC62C\uB77C\uAC04\uB2E4. \uD55C\uBC88 \uC0AC\uC6A9\uD558\uBA74
      \uAC8C\uC784\uC5D0\uC11C \uC81C\uC678\uB41C\uB2E4.\r\n2. \uAC00\uBB44 [4\uC7A5]\r\n\uC0C1\uB300\uB294
      \uB2E4\uC74C \uD134\uC5D0 \uC0DD\uC0B0\uC790\uC758 \uC0DD\uC0B0\uC744 \uC5BB\uC744
      \uC218 \uC5C6\uB2E4. \uC131\uC758 \uC0DD\uC0B0\uC5D0\uB294 \uC601\uD5A5\uC744
      \uC8FC\uC9C0 \uC54A\uB294\uB2E4.\r\n3. \uD48D\uB144 [4\uC7A5]\r\n\uAE08\uAD34
      4\uAC1C\uB97C \uD68D\uB4DD\uD55C\uB2E4. \uC0C1\uB300\uAC00 \uAC00\uBB44 \uCE74\uB4DC\uB97C
      \uC37C\uB354\uB77C\uB3C4 \uC601\uD5A5\uC744 \uBC1B\uC9C0 \uC54A\uACE0 \uC4F8
      \uC218 \uC788\uB2E4.\r\n4. \uB3C4\uB85C \uBCC0\uD615 [6\uC7A5]\r\n\uC790\uC2E0\uC758
      \uB3C4\uB85C\uC640 \uC5F0\uACB0\uB41C \uC0C1\uB300\uC758 \uB3C4\uB85C\uB97C
      1\uAC1C \uC120\uD0DD\uD574\uC11C \uBCC0\uACBD\uD55C\uB2E4.\r\n5. \uD654\uB825
      [15\uC7A5]\r\n\uB300\uD3EC\uAC00 \uC6D0\uAC70\uB9AC \uACF5\uACA9\uC744 \uD558\uAC70\uB098
      \uC0C1\uB300 \uB300\uD3EC\uC758 \uACF5\uACA9\uC744 \uBC29\uC5B4\uD560 \uC218
      \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2527682799337472
    m_Localized: "\uBA54\uC778 \uD134\r\n\uBA54\uC778 \uD134\uC740 \uB3C4\uB85C\uC640
      \uAE30\uBB3C(\uC0DD\uC0B0\uC790, \uBCF4\uBCD1, \uB300\uD3EC)\uC744 \uC0DD\uC131\uD558\uACE0
      \uC774\uB3D9 \uBC0F \uACF5\uACA9\uC744 \uD558\uB294 \uD134\uC774\uB2E4. \uB3C4\uB85C\uB294
      \uC790\uC2E0\uC758 \uC0DD\uC0B0 \uD134\uC5D0 2\uAC1C\uC529 \uBB34\uB8CC\uB85C
      \uC8FC\uC5B4\uC9C0\uB294\uB370 \uC0AC\uC6A9\uD558\uC9C0 \uC54A\uC73C\uBA74
      \uC18C\uBA78\uB41C\uB2E4. \uC0DD\uC0B0\uC790\uB294 \uAE08\uAD34 1\uAC1C, \uBCF4\uBCD1\uC740
      \uAE08\uAD34 3\uAC1C, \uB300\uD3EC\uB294 \uAE08\uAD34 5\uAC1C\uB85C \uAD6C\uB9E4\uD574\uC11C
      \uC0DD\uC131\uD55C\uB2E4.\r\n(\uB3C4\uB85C : \uB9E4 \uD134\uB9C8\uB2E4 2\uAC1C
      / \uC0DD\uC0B0\uC790 : \uAE08\uAD34 1\uAC1C / \uBCF4\uBCD1 : \uAE08\uAD34 3\uAC1C
      / \uB300\uD3EC : \uAE08\uAD34 5\uAC1C)\r\n\uB3C4\uB85C\uC758 \uC5ED\uD560\uC740
      \uAE30\uBB3C\uC758 \uBE60\uB978 \u2018\uC774\uB3D9\uB85C\u2019\uC640 \uC0DD\uC0B0\uC790\uC758
      \uAE08\uD654 \u2018\uACF5\uAE09\uB85C\u2019\uC774\uB2E4. \uB3C4\uB85C\uAC00
      \uAE38\uAC8C \uC5F0\uACB0\uB418\uC5B4 \uC788\uB2E4\uBA74 \uBA3C \uC9C0\uC810\uAE4C\uC9C0
      \uD55C \uBC88\uC5D0 \uC774\uB3D9 \uAC00\uB2A5\uD558\uACE0 \uC0C1\uB300 \uAE30\uBB3C\uC758
      \uC774\uB3D9\uC744 \uB9C9\uC744 \uC218\uB3C4 \uC788\uB2E4. \uC0DD\uC0B0\uC790\uB294
      \uB3C4\uB85C\uB97C \uD1B5\uD574 \uC131\uACFC \uC5F0\uACB0\uB418\uC5B4\uC57C\uB9CC
      \uAE08\uD654\uB97C \uC81C\uACF5\uD558\uAE30 \uB54C\uBB38\uC5D0 \uB3C4\uB85C\uB294
      \uBCF4\uAE09\uB85C\uC758 \uC5ED\uD560 \uB610\uD55C \uB9E1\uACE0 \uC788\uB2E4.\r\n\uB3C4\uB85C\uB294
      \uC790\uC2E0\uC758 \uC131\uACFC \uC5F0\uACB0\uB418\uC5B4 \uC788\uC5B4\uC57C
      \uC5F0\uC7A5\uC774 \uAC00\uB2A5\uD558\uB2E4. \uB9CC\uC57D \uB3C4\uB85C\uAC00
      \uC131\uACFC \uC5F0\uACB0\uB418\uC5B4 \uC788\uC9C0 \uC54A\uB2E4\uBA74, \uB3C4\uB85C\uB97C
      \uC774\uC6A9\uD558\uB294 \uAC83\uC740 \uAC00\uB2A5\uD558\uC9C0\uB9CC \uB04A\uC5B4\uC9C4
      \uB3C4\uB85C\uB85C\uBD80\uD130 \uC0C8\uB85C\uC6B4 \uB3C4\uB85C\uB97C \uC5F0\uC7A5\uD558\uB294
      \uAC83\uC740 \uBD88\uAC00\uB2A5\uD558\uB2E4. \uBB34\uC870\uAC74 \uC131\uACFC
      \uC5F0\uACB0\uB41C \uB3C4\uB85C\uB9CC \uC5F0\uC7A5\uC774 \uAC00\uB2A5\uD558\uB2E4.
      \uAC8C\uC784\uD310 \uC704\uC5D0 \uB354 \uC774\uC0C1 \uB3C4\uB85C\uB97C \uC0DD\uC131\uD560
      \uACF5\uAC04\uC774 \uC5C6\uB294 \uACBD\uC6B0\uC5D0\uB294 \uB3C4\uB85C \uAC74\uC124\uC744
      \uD558\uC9C0 \uC54A\uB294\uB2E4.\n\n\uAE30\uBB3C(\uC0DD\uC0B0\uC790, \uBCF4\uBCD1,
      \uB300\uD3EC)\uC740 \uBB34\uC870\uAC74 \uC131\uC774 \uC788\uB294 \uD0C0\uC77C\uC758
      \uAF2D\uC9D3\uC810\uC5D0\uC11C \uC0DD\uC131\uD574\uC57C \uD558\uACE0 \uD55C
      \uD134\uC5D0 1\uAC1C\uB9CC \uC120\uD0DD\uD574\uC11C \uC0DD\uC131\uD560 \uC218
      \uC788\uB2E4. \uB610\uD55C \uD55C \uAF2D\uC9D3\uC810\uC5D0 \uB450 \uAC1C \uC774\uC0C1\uC758
      \uAE30\uBB3C\uC774 \uC0DD\uC131\uB418\uAC70\uB098 \uBC30\uCE58\uB420 \uC218
      \uC5C6\uACE0, \uC0C1\uB300 \uAE30\uBB3C\uACFC \uD55C \uCE78 \uCC28\uC774\uB85C
      \uB9C8\uC8FC\uBCF4\uACE0 \uC788\uB294 \uAF2D\uC9D3\uC810\uC5D0\uB3C4 \uAE30\uBB3C\uC744
      \uC0DD\uC131\uD560 \uC218 \uC5C6\uB2E4. \uC608\uB97C \uB4E4\uC5B4 \uC624\uB978\uCABD
      \uC0AC\uC9C4\uC758 \uAC80\uC740\uC0C9 \uC6D0 \uC704\uCE58\uB294 \uC0C1\uB300
      \uAE30\uBB3C\uC744 \uD55C \uCE78 \uCC28\uC774\uB85C \uB9C8\uC8FC\uBCF4\uACE0
      \uC788\uC5B4\uC11C \uAE30\uBB3C \uC0DD\uC131\uC774 \uBD88\uAC00\uB2A5\uD558\uB2E4.\r\n\uAE30\uBB3C
      \uC0DD\uC131 \uC774\uD6C4\uC5D0\uB294 \uAC8C\uC784\uD310 \uC704\uC5D0 \uC788\uB294
      \uC0DD\uC0B0\uC790 1\uAE30, \uBCF4\uBCD1 1\uAE30, \uB300\uD3EC 1\uAE30\uB97C
      \uC120\uD0DD\uD574\uC11C \uC774\uB3D9 \uBC0F \uACF5\uACA9\uC744 \uD560 \uC218
      \uC788\uB2E4. \uBA3C\uC800 \uC774\uB3D9 \uBC29\uC2DD\uC5D0\uB294 2\uAC00\uC9C0\uAC00
      \uC788\uB294\uB370, \uCCAB\uBC88\uC9F8 \uBC29\uC2DD\uC740 \uB3C4\uB85C\uB97C
      \uC774\uC6A9\uD558\uC9C0 \uC54A\uB294 \uBC29\uC2DD\uC774\uB2E4. \uBCF4\uBCD1\uC740
      \uB3C4\uB85C\uC758 \uC5EC\uBD80\uC640 \uC0C1\uAD00\uC5C6\uC774 \uBB34\uC870\uAC74
      1\uCE78\uC744 \uC774\uB3D9\uD560 \uC218 \uC788\uACE0, \uC0DD\uC0B0\uC790\uC640
      \uB300\uD3EC\uB294 \uC0C1\uB300 \uB3C4\uB85C\uAC00 \uB193\uC774\uC9C0 \uC54A\uC740
      \uACF3\uC774\uB77C\uBA74 1\uCE78 \uC774\uB3D9\uD560 \uC218 \uC788\uB2E4. \uB450\uBC88\uC9F8
      \uBC29\uC2DD\uC740 \uB3C4\uB85C\uB97C \uC774\uC6A9\uD558\uB294 \uBC29\uC2DD\uC774\uB2E4.
      \uBAA8\uB4E0 \uAE30\uBB3C\uC740 \uC790\uC2E0\uC758 \uB3C4\uB85C\uAC00 \uC5F0\uACB0\uB41C
      \uC9C0\uC810\uC774\uB77C\uBA74 \uAC70\uB9AC\uC640 \uC0C1\uAD00\uC5C6\uC774
      \uD55C \uBC88\uC5D0 \uC774\uB3D9\uD560 \uC218 \uC788\uB2E4. \uC774 \uB450\uAC00\uC9C0
      \uBC29\uC2DD \uC911 \uD558\uB098\uB9CC \uC120\uD0DD\uD574\uC11C \uC774\uB3D9\uD574\uC57C
      \uD558\uBA70 \uD55C \uBC88 \uC774\uB3D9 \uD6C4 \uC7AC\uC774\uB3D9\uC740 \uD560
      \uC218 \uC5C6\uB2E4.\r\n\n\uAC01 \uAE30\uBB3C\uC758 \uD2B9\uC218 \uB2A5\uB825\uACFC
      \uACF5\uACA9 \uBC29\uC2DD\uC5D0 \uB300\uD55C \uC124\uBA85\uC740 \uB2E4\uC74C\uACFC
      \uAC19\uB2E4.\r\n\uBA3C\uC800 \uC0DD\uC0B0\uC790\uB294 \uC0DD\uC0B0\uC5D0 \uD2B9\uD654\uB41C
      \uAE30\uBB3C\uC774\uAE30 \uB54C\uBB38\uC5D0 \uACF5\uACA9\uC744 \uD560 \uC218
      \uC5C6\uB2E4.\r\n\uBCF4\uBCD1\uC740 \uC811\uD558\uB294 \uBAA8\uB4E0 \uB3C4\uB85C\uB97C
      \uC790\uC2E0\uC758 \uB3C4\uB85C\uB85C \uBC14\uAFB8\uB294 \u2018\uD2B9\uC218
      \uB2A5\uB825\u2019\uACFC \uC0C1\uB300\uC758 \uBCF4\uBCD1\uACFC \uC0DD\uC0B0\uC790\uB97C
      \uACF5\uACA9\uD560 \uC218 \uC788\uB294 \u2018\uADFC\uAC70\uB9AC \uACF5\uACA9\u2019\uC744
      \uAC00\uC9C0\uACE0 \uC788\uB2E4. \uACF5\uACA9\uD558\uACE0\uC790 \uD558\uB294
      \uAE30\uBB3C\uC758 \uC704\uCE58\uB85C \uC774\uB3D9\uD574\uC11C \uC0C1\uB300\uC758
      \uAE30\uBB3C\uC744 \uD30C\uAD34\uD558\uB294 \uC2DD\uC73C\uB85C \uACF5\uACA9\uD558\uB294
      \uAE30\uBB3C\uC774\uACE0, \uACF5\uACA9\uACFC \uB3D9\uC2DC\uC5D0 \uD2B9\uC218
      \uB2A5\uB825\uC73C\uB85C \uC811\uD558\uB294 \uB3C4\uB85C\uB97C \uBAA8\uB450
      \uC790\uC2E0\uC758 \uB3C4\uB85C\uB85C \uBC14\uAFBC\uB2E4. \uACF5\uACA9\uD558\uC9C0
      \uC54A\uACE0 \uC774\uB3D9\uB9CC \uD558\uB354\uB77C\uB3C4 \uC774\uB3D9\uD55C
      \uC704\uCE58\uC5D0\uC11C \uD2B9\uC218 \uB2A5\uB825\uC744 \uC774\uC6A9\uD560
      \uC218 \uC788\uB2E4.\r\n\uB300\uD3EC\uB294 \uD55C \uCE78 \uB5A8\uC5B4\uC9C4
      \uC0C1\uB300\uB97C \uACF5\uACA9\uD558\uB294 \u2018\uC6D0\uAC70\uB9AC \uACF5\uACA9\u2019\uACFC
      \uBCF4\uBCD1\uCC98\uB7FC \uACF5\uACA9\uD558\uACE0\uC790 \uD558\uB294 \uAE30\uBB3C\uC758
      \uC704\uCE58\uB85C \uC774\uB3D9\uD574\uC11C \uC704\uCE58\uB97C \uD0C8\uD658\uD558\uB294
      \u2018\uADFC\uAC70\uB9AC \uACF5\uACA9\u2019\uC744 \uBAA8\uB450 \uD560 \uC218
      \uC788\uB2E4. \uB2E8, \uC6D0\uAC70\uB9AC \uACF5\uACA9\uC740 \u2018\uD654\uB825\u2019
      \uCE74\uB4DC\uAC00 \uC788\uC5B4\uC57C \uAC00\uB2A5\uD558\uBA70 1\uC7A5\uC744
      \uC18C\uBAA8\uD55C\uB2E4. \uB300\uD3EC \uAC04\uC758 \uC2F8\uC6C0\uC740 \uBB34\uC870\uAC74
      \uC6D0\uAC70\uB9AC \uACF5\uACA9\uC73C\uB85C\uB9CC \uACF5\uACA9\uD574\uC57C
      \uD558\uBA70, \uD654\uB825 \uCE74\uB4DC\uB97C \uC81C\uC2DC\uD574\uC11C \uACF5\uACA9\uD588\uC744
      \uB54C \uC0C1\uB300 \uB610\uD55C \uD654\uB825 \uCE74\uB4DC\uB97C \uC81C\uC2DC\uD55C\uB2E4\uBA74
      \uBB34\uC2B9\uBD80\uAC00 \uB418\uC5B4 \uAC01\uC790\uC758 \uB300\uD3EC\uB294
      \uD30C\uAD34\uB418\uC9C0 \uC54A\uACE0 \uD654\uB825 \uCE74\uB4DC\uB9CC \uC18C\uBAA8\uB41C\uB2E4.
      \uB9CC\uC57D \uC0C1\uB300\uAC00 \uD654\uB825 \uCE74\uB4DC\uB97C \uC81C\uC2DC\uD558\uC9C0
      \uBABB\uD55C\uB2E4\uBA74 \uC0C1\uB300\uC758 \uC804\uCC28\uB294 \uD30C\uAD34\uB41C\uB2E4.
      \uB300\uD3EC\uB294 \uD55C \uC704\uCE58\uB85C \uC774\uB3D9\uD574\uC11C \uADFC\uAC70\uB9AC
      \uACF5\uACA9\uC744 \uD558\uACE0, \uC774\uC5B4\uC11C \uD55C \uCE78 \uB5A8\uC5B4\uC9C4
      \uACF3\uC5D0 \uC6D0\uAC70\uB9AC \uACF5\uACA9\uAE4C\uC9C0 \uD558\uB294 \uAC83\uB3C4
      \uAC00\uB2A5\uD558\uB2E4.\r\n\uD30C\uAD34\uB41C \uAE30\uBB3C\uC740 \uBAA8\uB450
      \uAC01 \uD50C\uB808\uC774\uC5B4\uC5D0\uAC8C \uB3CC\uC544\uAC00 \uB2E4\uC2DC
      \uC0DD\uC131\uB420 \uB54C\uAE4C\uC9C0 \uB300\uAE30\uD55C\uB2E4.\r\n\uAE30\uBB3C\uC774
      \uC131\uC744 \uACF5\uACA9\uD558\uB294 \uBC29\uC2DD\uC740 \uAE30\uBB3C\uC744
      \uACF5\uACA9\uD560 \uB54C\uC640 \uAC19\uB2E4. \uBCF4\uBCD1\uC758 \uACBD\uC6B0,
      \uC0C1\uB300 \uC131\uC774 \uB193\uC5EC\uC9C4 \uD0C0\uC77C\uC758 \uAF2D\uC9D3\uC810\uC5D0
      \uB3C4\uB2EC\uD558\uBA74 \uC0C1\uB300\uC758 \uCCB4\uB825\uC744 1\uB9CC\uD07C
      \uC5C6\uC564\uB2E4. \uB300\uD3EC\uC758 \uACBD\uC6B0, \uBCF4\uBCD1\uCC98\uB7FC
      \uC0C1\uB300 \uC131\uC5D0 \uB3C4\uB2EC\uD574 \uADFC\uAC70\uB9AC \uACF5\uACA9\uC744
      \uD558\uAC70\uB098 \uC0C1\uB300 \uC131\uC73C\uB85C\uBD80\uD130 1\uCE78 \uB5A8\uC5B4\uC9C4
      \uACF3\uC5D0\uC11C \uD654\uB825\uC744 1\uC7A5 \uC0AC\uC6A9\uD574 \uC6D0\uAC70\uB9AC
      \uACF5\uACA9\uC744 \uD560 \uC218 \uC788\uACE0 \uC0C1\uB300\uC758 \uCCB4\uB825\uC744
      2\uB9CC\uD07C \uC5C6\uC564\uB2E4.\r\n\uC0C1\uB300 \uC131 \uACF5\uACA9\uC5D0
      \uC131\uACF5\uD55C \uAE30\uBB3C\uC740 \uADF8 \uC989\uC2DC \uAC8C\uC784\uC5D0\uC11C
      \uC81C\uC678\uB418\uBA70, \uB2E4\uC2DC \uC7AC\uC0AC\uC6A9\uD560 \uC218 \uC5C6\uB2E4.
      \uAC8C\uC784 \uD6C4\uBC18\uC73C\uB85C \uAC08\uC218\uB85D \uAE30\uBB3C \uC218\uAC00
      \uC904\uC5B4\uB4E4\uAE30 \uB54C\uBB38\uC5D0 \uC804\uB7B5\uC801\uC778 \uD50C\uB808\uC774\uAC00
      \uC694\uAD6C\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
