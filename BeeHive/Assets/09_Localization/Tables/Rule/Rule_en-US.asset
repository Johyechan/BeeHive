  m_SharedData: {fileID: 11400000, guid: f8ce8538dbe596345945145ec7e17596, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 23901465837568000
    m_Localized: How to win
    m_Metadata:
      m_Items: []
  - m_Id: 23901985910292480
    m_Localized: Defeat your opponent by reducing their HP to 0.
    m_Metadata:
      m_Items: []
  - m_Id: 23902546864898048
    m_Localized: Phase
    m_Metadata:
      m_Items: []
  - m_Id: 23903102853447680
    m_Localized: Team Change
    m_Metadata:
      m_Items: []
  - m_Id: 23903297582399488
    m_Localized: The phase passes to the other team.
    m_Metadata:
      m_Items: []
  - m_Id: 23904639164088320
    m_Localized: Turn End
    m_Metadata:
      m_Items: []
  - m_Id: 23908419586752512
    m_Localized: '- Gain 2 Gold Bars each phase.


      - Exception: The Blue Team
      gains 4 Gold Bars on its first phase.


      - Producers generate Gold.'
    m_Metadata:
      m_Items: []
  - m_Id: 23909811244236800
    m_Localized: '- You can draw during this phase.


      - You can only draw once
      per phase.'
    m_Metadata:
      m_Items: []
  - m_Id: 23910492587950080
    m_Localized: '- You can deploy, move, and attack with units during this phase.


      -
      You can only deploy units once per phase.


      - Each unit type can only
      move and attack once per phase.'
    m_Metadata:
      m_Items: []
  - m_Id: 23910913914175488
    m_Localized: '- The current team''s phase ends, and the game proceeds to the
      team switch phase.'
    m_Metadata:
      m_Items: []
  - m_Id: 23918661267619840
    m_Localized: Card
    m_Metadata:
      m_Items: []
  - m_Id: 23925236568948736
    m_Localized: Modify Road Card
    m_Metadata:
      m_Items: []
  - m_Id: 23925103685009408
    m_Localized: Fire Power Card
    m_Metadata:
      m_Items: []
  - m_Id: 23924910520532992
    m_Localized: Drought Card
    m_Metadata:
      m_Items: []
  - m_Id: 23924748133859328
    m_Localized: Prosperity Card
    m_Metadata:
      m_Items: []
  - m_Id: 23924688109174784
    m_Localized: Castle Upgrade Card
    m_Metadata:
      m_Items: []
  - m_Id: 23926802965331968
    m_Localized: "- Allows a Bombard to perform a ranged attack \n  or defend against
      an incoming enemy Bombard attack."
    m_Metadata:
      m_Items: []
  - m_Id: 23929431380459520
    m_Localized: "- Immediately gain 4 Gold Bars. \n  This card can be played even
      if a \n  \"Drought\" card was used against you."
    m_Metadata:
      m_Items: []
  - m_Id: 23929881576079360
    m_Localized: "- Your opponent cannot collect production from \n  their Miners
      on their next turn. \n  (Does not affect Castle production)."
    m_Metadata:
      m_Items: []
  - m_Id: 23930527863799808
    m_Localized: "- Select and change one of your \n  opponent's roads that is connected
      to \n  your own road."
    m_Metadata:
      m_Items: []
  - m_Id: 23930835000098816
    m_Localized: "- Reinforce your walls  to increase your \n  Castle\u2019s HP by
      1. \n  (Removed from the game after use)."
    m_Metadata:
      m_Items: []
  - m_Id: 23934289735057408
    m_Localized: Piece
    m_Metadata:
      m_Items: []
  - m_Id: 23935375761997824
    m_Localized: '- Generates a different amount of Gold Coins each Production Phase
      depending on its current position.


      - Cannot produce if it is not connected
      to a road linked to a Castle.


      - Non-combat unit.'
    m_Metadata:
      m_Items: []
  - m_Id: 23935994723827712
    m_Localized: '- Converts enemy roads within the surrounding area of its movement
      or deployment location into friendly roads.


      - Can attack Miner and
      Pioneer units.'
    m_Metadata:
      m_Items: []
  - m_Id: 23936568668192768
    m_Localized: '- Can perform ranged attacks using Firepower cards.


      - Can
      attack Miner and Pioneer units.


      - Bombard units can only be destroyed
      by ranged attacks.


      - Can attack Castles with ranged attacks.


      -
      You can use Firepower cards to defend against enemy Bombard ranged attacks.


      -
      Can move or perform a attack before making a ranged attack.

      

      -
      Cannot move or perform a attack after making a ranged attack.'
    m_Metadata:
      m_Items: []
  - m_Id: 23938738515869696
    m_Localized: '- A unit that supports movement of other units.


      - Can only
      be used when it is connected to a Castle.'
    m_Metadata:
      m_Items: []
  - m_Id: 24245917152182272
    m_Localized: View Info
    m_Metadata:
      m_Items: []
  - m_Id: 24246338725871616
    m_Localized: UI Card Info
    m_Metadata:
      m_Items: []
  - m_Id: 24246526727159808
    m_Localized: Gold Count
    m_Metadata:
      m_Items: []
  - m_Id: 24246824468217856
    m_Localized: Used Card Count
    m_Metadata:
      m_Items: []
  - m_Id: 24247219953336320
    m_Localized: '- The effect panel appears when you right-click a UI card.'
    m_Metadata:
      m_Items: []
  - m_Id: 24247523352510464
    m_Localized: "- Hover over the Gold and Gold Bar UI to view next turn\u2019s
      Gold and Gold Bars."
    m_Metadata:
      m_Items: []
  - m_Id: 24247865226035200
    m_Localized: '- Click the area next to the deck to view used cards.'
    m_Metadata:
      m_Items: []
  - m_Id: 24248429020184576
    m_Localized: Combat
    m_Metadata:
      m_Items: []
  - m_Id: 24249749756182528
    m_Localized: How To Combat
    m_Metadata:
      m_Items: []
  - m_Id: 24250086655262720
    m_Localized: Combat Result
    m_Metadata:
      m_Items: []
  - m_Id: 24250377446359040
    m_Localized: Attack Castle
    m_Metadata:
      m_Items: []
  - m_Id: 24250748692594688
    m_Localized: Capture Point
    m_Metadata:
      m_Items: []
  - m_Id: 24250867668221952
    m_Localized: "- When you select one of your units, \n  any enemy unit within
      a valid movement range \n  can be attacked."
    m_Metadata:
      m_Items: []
  - m_Id: 24251459706814464
    m_Localized: "- On attack, the enemy unit is destroyed \n  and your unit moves
      into its position."
    m_Metadata:
      m_Items: []
  - m_Id: 24251770307608576
    m_Localized: "- If a unit moves onto a Castle attack tile, \n  it deals damage
      to the Castle and is permanently removed."
    m_Metadata:
      m_Items: []
  - m_Id: 24252080006627328
    m_Localized: "- If you place one of your units on the tile in front of a Castle
      attack tile, \n  the opponent cannot deploy units to that Castle attack tile."
    m_Metadata:
      m_Items: []
  - m_Id: 24252608442793984
    m_Localized: Word
    m_Metadata:
      m_Items: []
  - m_Id: 24252811526799360
    m_Localized: Castle Attack Tile
    m_Metadata:
      m_Items: []
  - m_Id: 24253201655791616
    m_Localized: Connected To ~
    m_Metadata:
      m_Items: []
  - m_Id: 24253865362456576
    m_Localized: '- A tile where units are created.'
    m_Metadata:
      m_Items: []
  - m_Id: 24254412517801984
    m_Localized: "- Only roads continuously connected to the Castle are considered
      connected.\n  Unit deployment tiles adjacent to such roads are also considered
      connected."
    m_Metadata:
      m_Items: []
  references:
