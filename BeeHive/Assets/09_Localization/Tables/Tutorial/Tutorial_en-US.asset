  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Tutorial_en-US
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en-US
  m_SharedData: {fileID: 11400000, guid: 153d8c0ec741d4c47905c2b2b2b0fc46, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1085775795716096
    m_Localized: Click Enter
    m_Metadata:
      m_Items: []
  - m_Id: 1083721568223232
    m_Localized: Your Castle
    m_Metadata:
      m_Items: []
  - m_Id: 1086113462353920
    m_Localized: Your HP
    m_Metadata:
      m_Items: []
  - m_Id: 1087966212259840
    m_Localized: Opponent Castle
    m_Metadata:
      m_Items: []
  - m_Id: 1088307888652288
    m_Localized: Opponent HP
    m_Metadata:
      m_Items: []
  - m_Id: 1088380294922240
    m_Localized: Your Gold
    m_Metadata:
      m_Items: []
  - m_Id: 1088704275546112
    m_Localized: Opponent Gold
    m_Metadata:
      m_Items: []
  - m_Id: 1088992512311296
    m_Localized: The castle you are viewing represents your team. Please keep this
      in mind.
    m_Metadata:
      m_Items: []
  - m_Id: 1089095679606784
    m_Localized: Defeat your opponent to win.
    m_Metadata:
      m_Items: []
  - m_Id: 1090931178340352
    m_Localized: Click Button
    m_Metadata:
      m_Items: []
  - m_Id: 1091042277064704
    m_Localized: Click Target
    m_Metadata:
      m_Items: []
  - m_Id: 1091434180247552
    m_Localized: 2 roads are generated each turn.
    m_Metadata:
      m_Items: []
  - m_Id: 1091955335102464
    m_Localized: 2 gold bars are also generated each turn.
    m_Metadata:
      m_Items: []
  - m_Id: 1092291927998464
    m_Localized: Press Next Turn to start the main turn.
    m_Metadata:
      m_Items: []
  - m_Id: 1092691267682304
    m_Localized: First, create a Miner.
    m_Metadata:
      m_Items: []
  - m_Id: 1093165073039360
    m_Localized: Miners earn different amounts of gold depending on their location.
    m_Metadata:
      m_Items: []
  - m_Id: 1093656779685888
    m_Localized: Earn 1 gold when placed in this location.
    m_Metadata:
      m_Items: []
  - m_Id: 1093892335992832
    m_Localized: Earn 3 gold when placed in this location.
    m_Metadata:
      m_Items: []
  - m_Id: 1094083407511552
    m_Localized: "Earn 5 gold when placed in this location. \n(5 gold is converted
      into a gold bar.)"
    m_Metadata:
      m_Items: []
  - m_Id: 1094345035612160
    m_Localized: "Let\u2019s continue."
    m_Metadata:
      m_Items: []
  - m_Id: 1094557330309120
    m_Localized: Press a unit button to place a unit.
    m_Metadata:
      m_Items: []
  - m_Id: 1095195627880448
    m_Localized: Select a placement location for Miner.
    m_Metadata:
      m_Items: []
  - m_Id: 1095923570311168
    m_Localized: "Click the Miner to move it. \n(It can move immediately after being
      placed.)"
    m_Metadata:
      m_Items: []
  - m_Id: 1096782429552640
    m_Localized: Select a destination.
    m_Metadata:
      m_Items: []
  - m_Id: 1098050631892992
    m_Localized: Press Next Turn to end the turn.
    m_Metadata:
      m_Items: []
  - m_Id: 1098999349903360
    m_Localized: The second player gains 3 gold bars instead of 2 on their first
      turn only.
    m_Metadata:
      m_Items: []
  - m_Id: 1099434097901568
    m_Localized: "This turn\u2019s gold coin was generated by Miners."
    m_Metadata:
      m_Items: []
  - m_Id: 1099754186211328
    m_Localized: "Let\u2019s create a road."
    m_Metadata:
      m_Items: []
  - m_Id: 1104915407306752
    m_Localized: "Let\u2019s create another road."
    m_Metadata:
      m_Items: []
  - m_Id: 1105872568451072
    m_Localized: "Let\u2019s create another road.\n(Roads can be created repeatedly\n
      as many times as the number of roads you have.)"
    m_Metadata:
      m_Items: []
  - m_Id: 1106270867947520
    m_Localized: "Let\u2019s create a Miner.\n(Only one piece can be created per
      turn.)"
    m_Metadata:
      m_Items: []
  - m_Id: 1431090126127104
    m_Localized: "Pioneers and Miners are destroyed instantly when hit by ranged
      attacks. \nLet\u2019s place one more road."
    m_Metadata:
      m_Items: []
  - m_Id: 1431416673665024
    m_Localized: "If your opponent does not use firepower in a Bombard battle, their
      Bombard will also be destroyed instantly. \nPress Next Turn to end your turn."
    m_Metadata:
      m_Items: []
  - m_Id: 1432376829542400
    m_Localized: "Pioneers and Miners are destroyed instantly when hit by ranged
      attacks. \nNow, let\u2019s move a Miner."
    m_Metadata:
      m_Items: []
  - m_Id: 1432887121149952
    m_Localized: "Attacking the opponent\u2019s spawn location deals damage to their
      castle (If an enemy unit is present, it is destroyed and the castle also takes
      damage.) \nNow, let\u2019s move a Pioneer."
    m_Metadata:
      m_Items: []
  - m_Id: 1435284585316352
    m_Localized: Now create a Miner.
    m_Metadata:
      m_Items: []
  - m_Id: 1435582020190208
    m_Localized: Move the Bombard.
    m_Metadata:
      m_Items: []
  - m_Id: 1436067091447808
    m_Localized: "Let\u2019s attack."
    m_Metadata:
      m_Items: []
  - m_Id: 1437645735198720
    m_Localized: Select a target for the ranged attack.
    m_Metadata:
      m_Items: []
  - m_Id: 1438042994507776
    m_Localized: Select an attack target.
    m_Metadata:
      m_Items: []
  - m_Id: 1438916999380992
    m_Localized: "Let\u2019s move a Miner."
    m_Metadata:
      m_Items: []
  - m_Id: 1439340120768512
    m_Localized: "Now, let\u2019s use a Bombard to destroy an enemy Pioneer."
    m_Metadata:
      m_Items: []
  - m_Id: 1439666307596288
    m_Localized: 'Select the Bombard again and perform a ranged attack.

      (Bombards
      can perform ranged attacks after moving.)'
    m_Metadata:
      m_Items: []
  - m_Id: 1440352126631936
    m_Localized: "Let\u2019s connect the roads."
    m_Metadata:
      m_Items: []
  - m_Id: 1440706465628160
    m_Localized: "Let\u2019s move a Pioneer."
    m_Metadata:
      m_Items: []
  - m_Id: 1440971218485248
    m_Localized: "Now, let\u2019s attack the enemy Miner."
    m_Metadata:
      m_Items: []
  - m_Id: 1441924227268608
    m_Localized: 'This is a Firepower card.

      It is used in Bombard combat and
      ranged attacks.'
    m_Metadata:
      m_Items: []
  - m_Id: 1442332391768064
    m_Localized: "Let\u2019s check the card."
    m_Metadata:
      m_Items: []
  - m_Id: 1442615884775424
    m_Localized: Right-click the target.
    m_Metadata:
      m_Items: []
  - m_Id: 1442963269615616
    m_Localized: "Now that we\u2019ve checked the card, let\u2019s proceed to the
      main turn."
    m_Metadata:
      m_Items: []
  - m_Id: 1443992375656448
    m_Localized: "Let\u2019s check the drawn card."
    m_Metadata:
      m_Items: []
  - m_Id: 1444594509938688
    m_Localized: Select a placement location for the Bombard.
    m_Metadata:
      m_Items: []
  - m_Id: 1444908990464000
    m_Localized: Select a placement location for the Pioneer.
    m_Metadata:
      m_Items: []
  - m_Id: 1445443663560704
    m_Localized: "Let\u2019s create a Bombard."
    m_Metadata:
      m_Items: []
  - m_Id: 1445792180862976
    m_Localized: "Let\u2019s create a Pioneer."
    m_Metadata:
      m_Items: []
  - m_Id: 1446972021800960
    m_Localized: "Pioneers can move one tile beyond enemy roads. \nThey also convert
      all adjacent roads at their destination to their team\u2019s roads."
    m_Metadata:
      m_Items: []
  - m_Id: 1447924011368448
    m_Localized: "Let\u2019s defend against the enemy Bombard\u2019s attack."
    m_Metadata:
      m_Items: []
  - m_Id: 1448179029245952
    m_Localized: 'You are under attack by an enemy Bombard.

      Use a Firepower
      card to defend?'
    m_Metadata:
      m_Items: []
  - m_Id: 1449335713431552
    m_Localized: If a Miner is not connected to the castle by roads, it cannot generate
      gold.
    m_Metadata:
      m_Items: []
  - m_Id: 1449634192687104
    m_Localized: 'Miners can jump one tile even without connected roads.

      (They
      cannot cross if an enemy road is in between.)'
    m_Metadata:
      m_Items: []
  - m_Id: 1450021586993152
    m_Localized: "Let\u2019s draw a card."
    m_Metadata:
      m_Items: []
  - m_Id: 1450271743672320
    m_Localized: "Let\u2019s destroy the enemy Bombard."
    m_Metadata:
      m_Items: []
  - m_Id: 1450634861346816
    m_Localized: If an enemy unit is on the tile in front of a spawn location, spawning
      there is blocked.
    m_Metadata:
      m_Items: []
  - m_Id: 1451504097296384
    m_Localized: "Let\u2019s attack the castle with a Bombard."
    m_Metadata:
      m_Items: []
  - m_Id: 1452099365502976
    m_Localized: Well done.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
