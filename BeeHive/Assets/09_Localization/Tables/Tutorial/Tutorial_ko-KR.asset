  m_TableData:
  - m_Id: 1083721568223232
    m_Localized: "\uB2F9\uC2E0\uC758 \uC131\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1085775795716096
    m_Localized: "\uC5D4\uD130 \uD074\uB9AD"
    m_Metadata:
      m_Items: []
  - m_Id: 1086113462353920
    m_Localized: "\uB2F9\uC2E0\uC758 \uCCB4\uB825\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1087966212259840
    m_Localized: "\uC0C1\uB300\uC758 \uC131\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1088307888652288
    m_Localized: "\uC0C1\uB300\uC758 \uCCB4\uB825\uACFC \uAE08\uD654 \uBC0F \uAE08\uAD34\uC785\uB2C8\uB2E4.\n(\uB9C8\uC6B0\uC2A4\uB97C
      \uC62C\uB9AC\uBA74 \uB2E4\uC74C \uD134 \uC608\uC0C1 \uAE08\uD654/\uAE08\uAD34\uB97C
      \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 1088380294922240
    m_Localized: "\uB2F9\uC2E0\uC758 \uAE08\uAD34 \uBC0F \uAE08\uD654 \uAC1C\uC218\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1088704275546112
    m_Localized: "\uC0C1\uB300\uC758 \uAE08\uAD34 \uBC0F \uAE08\uD654 \uAC1C\uC218\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1088992512311296
    m_Localized: "\uB2F9\uC2E0\uC774 \uBC14\uB77C\uBCF4\uB294 \uC2DC\uC810\uC758
      \uC131\uC774 \uB2F9\uC2E0\uC758 \uD300\uC774\uB2C8 \uC720\uC758\uD569\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1089095679606784
    m_Localized: "\uC0C1\uB300\uB97C \uACF5\uACA9\uD558\uC5EC \uC2B9\uB9AC\uD569\uC2DC\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1090931178340352
    m_Localized: "\uBC84\uD2BC \uD074\uB9AD"
    m_Metadata:
      m_Items: []
  - m_Id: 1091042277064704
    m_Localized: "\uB300\uC0C1 \uD074\uB9AD"
    m_Metadata:
      m_Items: []
  - m_Id: 1091434180247552
    m_Localized: "\uB9E4 \uD134 \uB3C4\uB85C\uAC00 2\uAC1C \uC0DD\uC131\uB418\uACE0,"
    m_Metadata:
      m_Items: []
  - m_Id: 1091955335102464
    m_Localized: "\uAE08\uAD34\uB3C4 2\uAC1C \uC0DD\uC131\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1092291927998464
    m_Localized: "\uB2E4\uC74C \uD134\uC744 \uB20C\uB7EC \uBA54\uC778 \uD134\uC744
      \uC9C4\uD589\uD569\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1092691267682304
    m_Localized: "\uCC98\uC74C\uC5D0\uB294 \uC0DD\uC0B0\uC790\uB97C \uB9CC\uB4E4\uC5B4\uBD05\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1093165073039360
    m_Localized: "\uC0DD\uC0B0\uC790\uB294 \uC704\uCE58\uC5D0 \uB530\uB77C \uAE08\uD654\uB97C
      \uB2E4\uB974\uAC8C \uBC95\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1093656779685888
    m_Localized: "\uD574\uB2F9 \uC704\uCE58\uC5D0 \uC788\uC73C\uBA74 \uAE08\uD654
      1\uAC1C\uB97C \uBC95\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1093892335992832
    m_Localized: "\uD574\uB2F9 \uC704\uCE58\uC5D0 \uC788\uC73C\uBA74 \uAE08\uD654
      3\uAC1C\uB97C \uBC95\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1094083407511552
    m_Localized: "\uD574\uB2F9 \uC704\uCE58\uC5D0 \uC788\uC73C\uBA74 \uAE08\uD654
      6\uAC1C\uB97C \uBC95\uB2C8\uB2E4.\n(\uAE08\uD654 5\uAC1C\uAC00 \uBAA8\uC774\uBA74
      \uAE08\uAD34 1\uAC1C\uB85C \uC804\uD658\uB429\uB2C8\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 1094345035612160
    m_Localized: "\uC774\uC5B4\uC11C \uC9C4\uD589\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1094557330309120
    m_Localized: "\uAE30\uBB3C \uBC84\uD2BC\uC744 \uB20C\uB7EC \uAE30\uBB3C\uC744
      \uBC30\uCE58\uD574\uBD05\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1095195627880448
    m_Localized: "\uC0DD\uC0B0\uC790 \uC0DD\uC131 \uC704\uCE58\uB97C \uC120\uD0DD\uD569\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1095923570311168
    m_Localized: "\uC0DD\uC0B0\uC790\uB97C \uD074\uB9AD\uD574\uC11C \uC774\uB3D9\uC744
      \uD569\uC2DC\uB2E4. \n(\uBC30\uCE58 \uC774\uD6C4 \uBC14\uB85C \uC774\uB3D9\uC774
      \uAC00\uB2A5\uD569\uB2C8\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 1096782429552640
    m_Localized: "\uC774\uB3D9 \uC704\uCE58\uB97C \uC120\uD0DD\uD569\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1098050631892992
    m_Localized: "\uB2E4\uC74C \uD134\uC744 \uB20C\uB7EC \uD134\uC744 \uC885\uB8CC\uD569\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1098999349903360
    m_Localized: "\uD6C4\uC21C\uC704 \uD50C\uB808\uC774\uC5B4\uB294 \uCCAB \uBC88\uC9F8
      \uD134\uC5D0\uB9CC \uAE08\uAD34\uB97C 2\uAC1C\uAC00 \uC544\uB2CC 3\uAC1C\uB97C
      \uD68D\uB4DD\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1099434097901568
    m_Localized: "\uC774\uBC88 \uD134\uC5D0 \uBC8C\uB9B0 \uAE08\uD654\uB294 \uC0DD\uC0B0\uC790\uAC00
      \uC0DD\uC0B0\uD55C \uAC83\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1099754186211328
    m_Localized: "\uB3C4\uB85C\uB97C \uC0DD\uC131\uD569\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1104915407306752
    m_Localized: "\uD55C \uBC88 \uB354 \uB3C4\uB85C\uB97C \uC0DD\uC131\uD574\uBD05\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1105872568451072
    m_Localized: "\uB3C4\uB85C\uB97C \uD55C \uBC88 \uB354 \uC0DD\uC131\uD569\uC2DC\uB2E4.
      \n(\uB3C4\uB85C\uB294 \uAC00\uC9C0\uACE0 \uC788\uB294 \uB3C4\uB85C \uAC1C\uC218\uB9CC\uD07C
      \uC911\uBCF5 \uC0DD\uC131 \uAC00\uB2A5\uD569\uB2C8\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 1106270867947520
    m_Localized: "\uC774\uBC88\uC5D0\uB294 \uC0DD\uC0B0\uC790\uB97C \uC0DD\uC131\uD569\uC2DC\uB2E4.
      \n(\uD55C \uD134\uC5D0 \uD55C \uAE30\uBB3C\uB9CC \uC0DD\uC131\uD560 \uC218
      \uC788\uC2B5\uB2C8\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 1431090126127104
    m_Localized: "\uBCF4\uBCD1\uACFC \uC0DD\uC0B0\uC790\uB294 \uC6D0\uAC70\uB9AC
      \uACF5\uACA9\uC744 \uB2F9\uD558\uBA74 \uC989\uC2DC \uD30C\uAD34\uB429\uB2C8\uB2E4.
      \n\uB3C4\uB85C\uB97C \uD558\uB098\uB9CC \uB354 \uBC30\uCE58\uD569\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1431416673665024
    m_Localized: "\uC0C1\uB300\uAC00 \uB300\uD3EC\uAC04\uC758 \uC2F8\uC6C0\uC5D0\uC11C
      \uD654\uB825\uC744 \uC0AC\uC6A9\uD558\uC9C0 \uC54A\uB294\uB2E4\uBA74 \uB300\uD3EC
      \uB610\uD55C \uC989\uC2DC \uD30C\uAD34\uB429\uB2C8\uB2E4. \n\uB2E4\uC74C \uD134\uC744
      \uB20C\uB7EC \uD134\uC744 \uC885\uB8CC\uD569\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1432376829542400
    m_Localized: "\uBCF4\uBCD1\uACFC \uC0DD\uC0B0\uC790\uB294 \uC6D0\uAC70\uB9AC
      \uACF5\uACA9\uC744 \uB2F9\uD558\uBA74 \uC989\uC2DC \uD30C\uAD34\uB429\uB2C8\uB2E4.
      \n\uC774\uC81C \uC0DD\uC0B0\uC790\uB97C \uC774\uB3D9\uD569\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1432887121149952
    m_Localized: "\uC0C1\uB300 \uD300\uC758 \uC0DD\uC131 \uC704\uCE58\uC5D0 \uACF5\uACA9\uC744
      \uAC00\uD558\uBA74 \uC0C1\uB300 \uC131\uC5D0 \uD53C\uD574\uB97C \uC904 \uC218
      \uC788\uC2B5\uB2C8\uB2E4\n(\uC0C1\uB300 \uAE30\uBB3C\uC774 \uC62C\uB824\uC838
      \uC788\uB2E4\uBA74 \uC0C1\uB300 \uAE30\uBB3C\uC774 \uD30C\uAD34\uB428\uACFC
      \uB3D9\uC2DC\uC5D0 \uC0C1\uB300 \uC131\uC5D0 \uB370\uBBF8\uC9C0\uB3C4 \uAC00\uD569\uB2C8\uB2E4.)\n\uC774\uC81C
      \uBCF4\uBCD1\uC744 \uC6C0\uC9C1\uC785\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1435284585316352
    m_Localized: "\uC774\uC81C \uC0DD\uC0B0\uC790\uB97C \uC0DD\uC131\uD569\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1435582020190208
    m_Localized: "\uB300\uD3EC\uB97C \uC774\uB3D9\uD569\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1436067091447808
    m_Localized: "\uACF5\uACA9\uC744 \uD569\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1437645735198720
    m_Localized: "\uC6D0\uAC70\uB9AC \uACF5\uACA9 \uB300\uC0C1\uC744 \uC120\uD0DD\uD569\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1438042994507776
    m_Localized: "\uACF5\uACA9 \uB300\uC0C1\uC744 \uC120\uD0DD\uD569\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1438916999380992
    m_Localized: "\uC0DD\uC0B0\uC790\uB97C \uC774\uB3D9\uC744 \uD569\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1439340120768512
    m_Localized: "\uC774\uC81C \uB300\uD3EC\uB97C \uC0AC\uC6A9\uD558\uC5EC \uC0C1\uB300
      \uBCF4\uBCD1\uC744 \uD30C\uAD34\uD574\uBD05\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1439666307596288
    m_Localized: "\uB300\uD3EC\uB97C \uB2E4\uC2DC \uC120\uD0DD\uD558\uC5EC \uC6D0\uAC70\uB9AC
      \uACF5\uACA9\uC744 \uD569\uC2DC\uB2E4.\n(\uB300\uD3EC\uB294 \uC774\uB3D9 \uD6C4
      \uC6D0\uAC70\uB9AC \uACF5\uACA9\uC774 \uAC00\uB2A5\uD569\uB2C8\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 1440352126631936
    m_Localized: "\uB3C4\uB85C\uB97C \uC5F0\uACB0\uD569\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1440706465628160
    m_Localized: "\uBCF4\uBCD1\uC744 \uC774\uB3D9\uD569\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1440971218485248
    m_Localized: "\uC774\uC81C \uC0C1\uB300 \uC0DD\uC0B0\uC790\uB97C \uACF5\uACA9\uD569\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1441924227268608
    m_Localized: "\uD654\uB825 \uCE74\uB4DC \uC785\uB2C8\uB2E4. \n\uB300\uD3EC\uAC04\uC758
      \uC804\uD22C \uBC0F \uC6D0\uAC70\uB9AC \uACF5\uACA9\uC5D0 \uC0AC\uC6A9\uB418\uB294
      \uCE74\uB4DC \uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1442332391768064
    m_Localized: "\uCE74\uB4DC\uB97C \uD655\uC778 \uD574\uBD05\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1442615884775424
    m_Localized: "\uB300\uC0C1 \uC6B0\uD074\uB9AD"
    m_Metadata:
      m_Items: []
  - m_Id: 1442963269615616
    m_Localized: "\uCE74\uB4DC\uB97C \uD655\uC778 \uD588\uC73C\uB2C8, \uC774\uC81C
      \uBA54\uC778 \uD134\uC73C\uB85C \uB118\uC5B4\uAC11\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1443992375656448
    m_Localized: "\uBF51\uC740 \uCE74\uB4DC\uB97C \uD655\uC778 \uD569\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1444594509938688
    m_Localized: "\uB300\uD3EC \uC0DD\uC131 \uC704\uCE58\uB97C \uC120\uD0DD\uD569\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1444908990464000
    m_Localized: "\uBCF4\uBCD1 \uC0DD\uC131 \uC704\uCE58\uB97C \uC120\uD0DD\uD569\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1445443663560704
    m_Localized: "\uB300\uD3EC\uB97C \uC0DD\uC131\uD569\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1445792180862976
    m_Localized: "\uBCF4\uBCD1\uC744 \uC0DD\uC131\uD569\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1446972021800960
    m_Localized: "\uBCF4\uBCD1\uC740 \uC0C1\uB300 \uB3C4\uB85C\uB97C \uD55C \uCE78
      \uB118\uC5B4\uAC08 \uC218 \uC788\uC2B5\uB2C8\uB2E4\n\uADF8\uB9AC\uACE0 \uBCF4\uBCD1\uC740
      \uC774\uB3D9\uD55C \uC704\uCE58\uC758 \uC8FC\uC704 \uB3C4\uB85C\uB4E4\uC744
      \uC804\uBD80 \uC790\uC2E0 \uD300\uC758 \uB3C4\uB85C\uB85C \uBCC0\uACBD \uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1447924011368448
    m_Localized: "\uC0C1\uB300 \uB300\uD3EC\uC758 \uACF5\uACA9\uC744 \uBC29\uC5B4\uD569\uC2DC\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1448179029245952
    m_Localized: "\uC0C1\uB300 \uB300\uD3EC\uC5D0\uAC8C \uACF5\uACA9 \uB2F9\uD588\uC2B5\uB2C8\uB2E4.
      \n\uD654\uB825 \uCE74\uB4DC\uB97C \uC0AC\uC6A9\uD558\uC5EC \uBC29\uC5B4 \uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1449335713431552
    m_Localized: "\uC0DD\uC0B0\uC790\uC640 \uC131\uC774 \uB3C4\uB85C\uB85C \uC5F0\uACB0\uB418\uC5B4
      \uC788\uC9C0 \uC54A\uB2E4\uBA74 \uC0DD\uC0B0\uC790\uAC00 \uAE08\uD654\uB97C
      \uBC8C\uC9C0 \uBABB\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1449634192687104
    m_Localized: "\uC0DD\uC0B0\uC790\uB294 \uB3C4\uB85C\uAC00 \uC5F0\uACB0\uB418\uC5B4
      \uC788\uC9C0 \uC54A\uC544\uB3C4 \uD55C \uCE78\uC744 \uB6F0\uC5B4 \uC774\uB3D9\uC774
      \uAC00\uB2A5\uD569\uB2C8\uB2E4.\n(\uC0C1\uB300 \uB3C4\uB85C\uAC00 \uC0AC\uC774\uC5D0
      \uC788\uB2E4\uBA74 \uB118\uC5B4\uAC08 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 1450021586993152
    m_Localized: "\uCE74\uB4DC\uB97C \uBF51\uC544\uBD05\uC2DC\uB2E4"
